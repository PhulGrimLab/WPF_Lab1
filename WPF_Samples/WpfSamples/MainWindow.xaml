<Window x:Class="WpfSamples.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSamples"
        mc:Ignorable="d"
        Title="WPF RTOS Scheduler Samples"
        Height="680"
        Width="1180"
        MinHeight="560"
        MinWidth="980">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F5F7FA">
        <Border DockPanel.Dock="Top"
                Background="#1F2937"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="RTOS Scheduler Samples"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Wpf.Lib.RTOS task monitor and test runner"
                               Foreground="#CBD5E1"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Start"
                            Command="{Binding StartCommand}"/>
                    <Button Content="Stop"
                            Command="{Binding StopCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="18">
            <TabItem Header="RTOS Monitor">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="White"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Scheduler:"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SchedulerState}"
                                       Margin="8,0,24,0"
                                       Foreground="#111827"/>

                            <TextBlock Grid.Column="2"
                                       Text="Last Snapshot:"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding LastSnapshotAt}"
                                       Margin="8,0,24,0"
                                       Foreground="#111827"/>

                            <TextBlock Grid.Column="4"
                                       Text="Counter, Clock, and UI Refresh tasks run by priority and period."
                                       Foreground="#4B5563"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Tasks}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              BorderBrush="#D7DCE2"
                              BorderThickness="1"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#F9FAFB"
                              RowBackground="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task"
                                                Binding="{Binding Name}"
                                                Width="170"/>
                            <DataGridTextColumn Header="Priority"
                                                Binding="{Binding Priority}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Period"
                                                Binding="{Binding Period}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Mode"
                                                Binding="{Binding Mode}"
                                                Width="90"/>
                            <DataGridTextColumn Header="State"
                                                Binding="{Binding State}"
                                                Width="100"/>
                            <DataGridCheckBoxColumn Header="Enabled"
                                                    Binding="{Binding IsEnabled, Mode=OneWay}"
                                                    Width="80"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Runs"
                                                Binding="{Binding RunCount}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Last Start"
                                                Binding="{Binding LastStartedAt}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Last Done"
                                                Binding="{Binding LastCompletedAt}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Duration"
                                                Binding="{Binding LastDuration}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Next Run"
                                                Binding="{Binding NextRunAt}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Error"
                                                Binding="{Binding LastError}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="RTOS Tests">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="White"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="Run Tests"
                                    Command="{Binding RunTestsCommand}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TestSummary}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="8,0,24,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="Runs unit-style checks for semaphore, message queue, tick counter, scheduler, and task state snapshots."
                                       Foreground="#4B5563"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TestResults}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              BorderBrush="#D7DCE2"
                              BorderThickness="1"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#F9FAFB"
                              RowBackground="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Test"
                                                Binding="{Binding Name}"
                                                Width="260"/>
                            <DataGridTextColumn Header="Result"
                                                Binding="{Binding Result}"
                                                Width="90"/>
                            <DataGridTextColumn Header="Duration"
                                                Binding="{Binding Duration}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
