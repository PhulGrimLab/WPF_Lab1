<Window x:Class="WpfSamples.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSamples"
        mc:Ignorable="d"
        Title="WPF RTOS Scheduler Samples"
        Height="768"
        Width="1024">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F5F7FA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border
                Background="#1F2937"
                Padding="18,14"
                Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="RTOS Scheduler Samples"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                        <TextBlock Text="Wpf.Lib.RTOS task monitor and test runner"
                               Foreground="#CBD5E1"
                               Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <Button Content="Start"
                            Command="{Binding StartCommand}"/>
                        <Button Content="Stop"
                            Command="{Binding StopCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Margin="18" Grid.Row="1">
                <TabItem Header="RTOS Monitor">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="#EEF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Scheduler:"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                                <TextBlock Grid.Column="1"
                                       Text="{Binding SchedulerState}"
                                       Margin="8,0,24,0"
                                       Foreground="#111827"/>

                                <TextBlock Grid.Column="2"
                                       Text="Last Snapshot:"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                                <TextBlock Grid.Column="3"
                                       Text="{Binding LastSnapshotAt}"
                                       Margin="8,0,24,0"
                                       Foreground="#111827"/>

                                <TextBlock Grid.Column="4"
                                       Text="Counter, Clock, and UI Refresh tasks run by priority and period."
                                       Foreground="#4B5563"
                                       TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Tasks}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              BorderBrush="#D7DCE2"
                              BorderThickness="1"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#F9FAFB"
                              RowBackground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Task"
                                                Binding="{Binding Name}"
                                                Width="170"/>
                                <DataGridTextColumn Header="Priority"
                                                Binding="{Binding Priority}"
                                                Width="90"/>
                                <DataGridTextColumn Header="Period"
                                                Binding="{Binding Period}"
                                                Width="100"/>
                                <DataGridTextColumn Header="Mode"
                                                Binding="{Binding Mode}"
                                                Width="90"/>
                                <DataGridTextColumn Header="State"
                                                Binding="{Binding State}"
                                                Width="100"/>
                                <DataGridCheckBoxColumn Header="Enabled"
                                                    Binding="{Binding IsEnabled, Mode=OneWay}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="160"/>
                                <DataGridTextColumn Header="Runs"
                                                Binding="{Binding RunCount}"
                                                Width="80"/>
                                <DataGridTextColumn Header="Last Start"
                                                Binding="{Binding LastStartedAt}"
                                                Width="120"/>
                                <DataGridTextColumn Header="Last Done"
                                                Binding="{Binding LastCompletedAt}"
                                                Width="120"/>
                                <DataGridTextColumn Header="Start TID"
                                                Binding="{Binding LastStartedThreadId}"
                                                Width="90"/>
                                <DataGridTextColumn Header="Done TID"
                                                Binding="{Binding LastCompletedThreadId}"
                                                Width="90"/>
                                <DataGridTextColumn Header="Duration"
                                                Binding="{Binding LastDuration}"
                                                Width="110"/>
                                <DataGridTextColumn Header="Next Run"
                                                Binding="{Binding NextRunAt}"
                                                Width="120"/>
                                <DataGridTextColumn Header="Error"
                                                Binding="{Binding LastError}"
                                                Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="현재 동작 중인 전체 Task"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,8"
                                       ToolTip="현재 스케줄러에 등록되어 있고 Enabled 상태인 task 목록입니다."/>
                                <ItemsControl ItemsSource="{Binding ActiveTasks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                Margin="0,0,8,0"
                                                Background="#F9FAFB">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           TextTrimming="CharacterEllipsis"/>
                                                    <Border Grid.Column="1"
                                                        Background="#E0F2FE"
                                                        CornerRadius="999"
                                                        Padding="8,2"
                                                        Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding State}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#075985"/>
                                                    </Border>

                                                    <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding Priority, StringFormat=Priority: {0}}"
                                                           Margin="0,7,0,0"
                                                           Foreground="#374151"/>
                                                    <StackPanel Grid.Row="2"
                                                            Grid.ColumnSpan="2"
                                                            Orientation="Vertical"
                                                            Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding RunCount, StringFormat=Runs: {0}}"
                                                               Foreground="#4B5563"/>
                                                        <TextBlock Text="{Binding LastDuration, StringFormat=  Duration: {0}}"
                                                               Margin="12,0,0,0"
                                                               Foreground="#4B5563"/>
                                                        <TextBlock Text="{Binding NextRunAt, StringFormat=  Next: {0}}"
                                                               Margin="12,0,0,0"
                                                               Foreground="#4B5563"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="선점 데모">
                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <StackPanel>

                            <Border Background="#EEF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="데모 시작"
                                    Command="{Binding StartPreemptionTestCommand}"
                                    ToolTip="협력형 선점 테스트를 시작합니다."/>
                                    <Button Grid.Column="1"
                                    Content="데모 중지"
                                    Command="{Binding StopPreemptionTestCommand}"
                                    ToolTip="협력형 선점 테스트를 중지합니다."/>

                                    <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="상태:"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"/>
                                        <TextBlock Text="{Binding PreemptionTestState}"
                                           Margin="6,0,0,0"
                                           Foreground="#111827"/>
                                    </StackPanel>

                                    <Border Grid.Column="3"
                                    Background="{Binding PreemptionHealthBadgeBackground}"
                                    CornerRadius="999"
                                    Padding="10,4"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="자동 상태 판정: 정상/관찰/주의/중지">
                                        <TextBlock Text="{Binding PreemptionHealthLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding PreemptionHealthBadgeForeground}"/>
                                    </Border>

                                    <TextBlock Grid.Column="4"
                                       Text="Low 우선순위 태스크가 실행 중일 때 High 태스크가 runnable 되면 context.ShouldYield()로 양보하는 과정을 실시간으로 확인할 수 있습니다."
                                       Foreground="#4B5563"
                                       TextWrapping="Wrap"
                                       Margin="12,0,0,0"/>

                                    <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="5"
                                        Orientation="Horizontal"
                                        Margin="0,10,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="기아 감지 민감도"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,10,0"/>
                                        <Slider Width="220"
                                            Minimum="1"
                                            Maximum="8"
                                            TickFrequency="0.5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding PreemptionStarvationLowStallSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="LOW RunCount/LastStartedAt 정체를 기아로 판정하기까지의 지연 시간(초)"/>
                                        <TextBlock Text="{Binding PreemptionStarvationLowStallLabel}"
                                           Margin="12,0,0,0"
                                           Foreground="#1F2937"
                                           FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                            Background="#EEF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="한눈에 보는 선점 흐름"
                                       FontWeight="SemiBold"
                                       Foreground="#1E3A8A"
                                       Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding PreemptionFlowHeadline}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PreemptionFlowDetail}"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                        Background="White"
                                        BorderBrush="#D7DCE2"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Ellipse Width="18" Height="18" Fill="{Binding PreemptionLowStepBrush}"/>
                                                <TextBlock Text="1. LOW 작업"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                           Text="→"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>

                                        <Border Grid.Column="2"
                                        Background="White"
                                        BorderBrush="#D7DCE2"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Ellipse Width="18" Height="18" Fill="{Binding PreemptionYieldStepBrush}"/>
                                                <TextBlock Text="2. LOW 양보"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="3"
                                           Text="→"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>

                                        <Border Grid.Column="4"
                                        Background="White"
                                        BorderBrush="#D7DCE2"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Ellipse Width="18" Height="18" Fill="{Binding PreemptionHighStepBrush}"/>
                                                <TextBlock Text="3. HIGH 선실행"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"
                                                   Margin="0,6,0,0"
                                                   HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Foreground="#1F2937"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap">
                                <Run Text="현재 구성: 낮은 우선순위 태스크 "/>
                                <Run Text="{Binding PreemptionLowTaskCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="개("/>
                                <Run Text="{Binding PreemptionLowTaskName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=") / 높은 우선순위 태스크 "/>
                                <Run Text="{Binding PreemptionHighTaskCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="개("/>
                                <Run Text="{Binding PreemptionHighTaskName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=")"/>
                                    </TextBlock>
                                    <TextBlock Foreground="#1E3A8A"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"
                                       Text="선점 판단 범위: RTOS 태스크(LOW/HIGH) 전용. UI 스레드는 선점 판정 대상에서 제외됩니다."/>
                                    <TextBlock Text="{Binding PreemptionHealthDescription}"
                                       Foreground="#1E3A8A"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"
                                       ToolTip="상태 배지가 왜 이렇게 표시되는지 설명합니다."/>
                                                <TextBlock Text="{Binding PreemptionStarvationStatus}"
                                                    Foreground="{Binding PreemptionStarvationForeground}"
                                                    FontWeight="SemiBold"
                                                    Margin="0,0,0,8"
                                                    ToolTip="RunCount/LastStartedAt 기반으로 LOW 기아 가능성을 감지합니다."/>
                                    <TextBlock Foreground="#1F2937"
                                       TextWrapping="Wrap"
                                       Text="설명문을 길게 읽지 않아도 됩니다. 위 3단계 원형 신호 중 초록색이 현재 진행 단계를 의미합니다."/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2"
                          Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="White"
                                BorderBrush="#D7DCE2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="낮은 우선순위 작업량"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           ToolTip="낮은 우선순위 태스크가 수행한 총 작업 단위입니다."/>
                                        <TextBlock Text="{Binding PreemptionLowWorkUnits}"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           ToolTip="값이 빠르게 증가하는데 양보 횟수가 늘지 않으면 선점이 충분히 일어나지 않는 신호입니다."/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                Background="White"
                                BorderBrush="#D7DCE2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="높은 우선순위 실행 횟수"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           ToolTip="높은 우선순위 태스크가 실제로 실행된 횟수입니다."/>
                                        <TextBlock Text="{Binding PreemptionHighRunCount}"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           ToolTip="이 값이 꾸준히 증가하면 높은 우선순위 태스크가 제때 실행되고 있다는 의미입니다."/>
                                        <TextBlock Text="{Binding PreemptionHighLastInterval, StringFormat=최근 실행 간격: {0}}"
                                           Margin="0,4,0,0"
                                           Foreground="#B91C1C"
                                           FontWeight="SemiBold"
                                           ToolTip="High Priority Urgent가 이전에 시작된 뒤 다시 시작되기까지 걸린 시간입니다."/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                Background="White"
                                BorderBrush="#D7DCE2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="양보 횟수"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           ToolTip="낮은 우선순위 태스크가 context.ShouldYield()로 양보한 횟수입니다."/>
                                        <TextBlock Text="{Binding PreemptionYieldCount}"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#111827"
                                           ToolTip="값이 증가할수록 협력형 선점이 정상적으로 발생하고 있음을 의미합니다."/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3"
                                Background="White"
                                BorderBrush="#D7DCE2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="최근 이벤트"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           ToolTip="가장 최근에 발생한 핵심 이벤트를 표시합니다."/>
                                        <TextBlock Text="{Binding LastPreemptionEvent}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#111827"
                                           ToolTip="최근 이벤트 메시지 상세 내용입니다."/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3"
                            Background="White"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="3"
                                       Text="태스크/스레드 실시간 인스펙터"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,8"
                                       ToolTip="현재 어떤 태스크가 동작 중인지, 마지막으로 어느 스레드에서 실행됐는지 표시합니다."/>

                                    <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Background="{Binding PreemptionLowInspectorBackground}"
                                    BorderBrush="{Binding PreemptionLowInspectorBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="LOW Priority Worker"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding PreemptionLowLastThreadId, StringFormat=마지막 실행 TID: {0}}"
                                               Margin="0,6,0,0"
                                               Foreground="#334155"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{Binding PreemptionHighInspectorBackground}"
                                    BorderBrush="{Binding PreemptionHighInspectorBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="HIGH Priority Urgent"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding PreemptionHighLastThreadId, StringFormat=마지막 실행 TID: {0}}"
                                               Margin="0,6,0,0"
                                               Foreground="#334155"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                    Grid.Column="2"
                                    Background="{Binding PreemptionCurrentInspectorBackground}"
                                    BorderBrush="{Binding PreemptionCurrentInspectorBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="현재 동작 태스크"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding PreemptionActiveTask}"
                                               Margin="0,6,0,0"
                                               Foreground="#334155"/>
                                            <TextBlock Text="{Binding PreemptionCurrentExecutionThreadLabel, StringFormat=현재 실행 TID: {0}}"
                                               Margin="0,6,0,0"
                                               Foreground="#1E3A8A"
                                               FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PreemptionUiThreadId, StringFormat=참고 UI TID: {0} (선점 판단 제외)}"
                                               Margin="0,6,0,0"
                                               Foreground="#64748B"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4"
                            Background="White"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock
                                       Text="양보 추이 (최근 10초)"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,8"
                                       ToolTip="각 막대는 해당 초(1초 단위)에서 발생한 양보 횟수를 의미합니다."/>
                                    <ItemsControl ItemsSource="{Binding PreemptionYieldTrend}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6"
                                                Margin="0,0,6,0"
                                                Background="#F9FAFB">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SecondLabel}"
                                                           FontSize="11"
                                                           Foreground="#6B7280"
                                                           HorizontalAlignment="Center"/>
                                                        <ProgressBar Minimum="0"
                                                             Maximum="{Binding DataContext.PreemptionTrendMaxYield, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                             Value="{Binding YieldCount, Mode=OneWay}"
                                                             Height="12"
                                                             Margin="0,6,0,4"/>
                                                        <TextBlock Text="{Binding YieldCount, StringFormat=Yields: {0}}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl
                                          ItemsSource="{Binding PreemptionLowWorkerYields}"
                                          Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#D1FAE5"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8"
                                                Margin="0,0,6,0"
                                                Background="#F0FDF4">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#065F46"
                                                           HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding YieldCount, StringFormat=양보: {0}회}"
                                                           Margin="0,5,0,0"
                                                           FontWeight="SemiBold"
                                                           Foreground="#111827"
                                                           HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LastResumeDelay, StringFormat=재개 대기: {0}}"
                                                           Margin="0,3,0,0"
                                                           Foreground="#374151"
                                                           HorizontalAlignment="Center"
                                                           ToolTip="해당 Low task가 양보한 뒤 다시 실행되기까지 걸린 최근 시간입니다."/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="5"
                            Background="White"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                                <DockPanel>
                                    <TextBlock
                                       Text="실시간 선점 로그"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"
                                       Margin="0,0,0,8"
                                       ToolTip="선점 관련 이벤트를 시간순으로 보여줍니다."/>
                                    <ListBox ItemsSource="{Binding PreemptionLogs}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     MaxHeight="180"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="철학자의 식사">
                    <ScrollViewer Margin="0,12,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,10,0">
                        <StackPanel>
                            <Border Background="#F8FAFC"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="시작"
                                            Command="{Binding StartDiningCommand}"
                                            ToolTip="철학자의 식사 데모를 시작합니다."/>
                                    <Button Grid.Column="1"
                                            Content="중지"
                                            Command="{Binding StopDiningCommand}"
                                            ToolTip="철학자의 식사 데모를 중지합니다."/>
                                    <Button Grid.Column="2"
                                            Content="초기화"
                                            Command="{Binding ResetDiningCommand}"
                                            ToolTip="식사 횟수, 대기 횟수, 로그를 초기화합니다."/>

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="상태:"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"/>
                                        <TextBlock Text="{Binding DiningState}"
                                                   Margin="6,0,0,0"
                                                   Foreground="#0F172A"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="시간:"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"/>
                                        <TextBlock Text="{Binding DiningElapsed}"
                                                   Margin="6,0,0,0"
                                                   Foreground="#0F172A"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="5"
                                               Text="{Binding DiningSummary}"
                                               Foreground="#475569"
                                               TextWrapping="Wrap"
                                               Margin="12,0,0,0"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="4"
                                               Text="{Binding DiningLastEvent, StringFormat=최근 이벤트: {0}}"
                                               Foreground="#1E3A8A"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="4"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding DiningConcurrentEatingStatus}"
                                               Foreground="#065F46"
                                               FontWeight="SemiBold"
                                               Margin="10,10,0,0"
                                               HorizontalAlignment="Right"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding DiningPhilosophers}"
                                          Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding CardBackground}"
                                                BorderBrush="{Binding AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,0,8,0"
                                                MinHeight="190">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel>
                                                    <Ellipse Width="12"
                                                             Height="12"
                                                             Fill="{Binding AccentBrush}"
                                                             Margin="0,0,8,0"
                                                             DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0F172A"
                                                               FontSize="15"/>
                                                </DockPanel>

                                                <Border Grid.Row="1"
                                                        Background="White"
                                                        CornerRadius="999"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding State}"
                                                               Foreground="#0F172A"
                                                               FontWeight="SemiBold"/>
                                                </Border>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding Detail}"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap"
                                                           Margin="0,10,0,0"/>

                                                <ProgressBar Grid.Row="3"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding ActivityProgress, Mode=OneWay}"
                                                             Height="12"
                                                             Margin="0,10,0,0"/>

                                                <StackPanel Grid.Row="4"
                                                            Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding LeftForkState}"
                                                               Foreground="#475569"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RightForkState}"
                                                               Foreground="#475569"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <Grid Grid.Row="5"
                                                      Margin="0,10,0,0"
                                                      VerticalAlignment="Bottom">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding MealCount, StringFormat=식사 {0}회}"
                                                               FontWeight="SemiBold"
                                                               Foreground="#065F46"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding WaitCount, StringFormat=대기 {0}회}"
                                                               HorizontalAlignment="Right"
                                                               Foreground="#92400E"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="White"
                                        BorderBrush="#D7DCE2"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="포크 점유 상태"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding DiningForks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Background}"
                                                            BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="9"
                                                            Margin="0,0,0,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#0F172A"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding State}"
                                                                       Foreground="#334155"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Holder}"
                                                                       Foreground="#334155"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="White"
                                        BorderBrush="#D7DCE2"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12">
                                    <DockPanel>
                                        <TextBlock Text="실시간 이벤트 로그"
                                                   DockPanel.Dock="Top"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   Margin="0,0,0,8"/>
                                        <ListBox ItemsSource="{Binding DiningLogs}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 MaxHeight="230"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="RTOS Tests">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="White"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Content="Run Tests"
                                    Command="{Binding RunTestsCommand}"/>
                                <TextBlock Grid.Column="1"
                                       Text="{Binding TestSummary}"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Margin="8,0,24,0"/>
                                <TextBlock Grid.Column="2"
                                       Text="Runs unit-style checks for semaphore, message queue, tick counter, scheduler, and task state snapshots."
                                       Foreground="#4B5563"
                                       TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TestResults}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              BorderBrush="#D7DCE2"
                              BorderThickness="1"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#F9FAFB"
                              RowBackground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Test"
                                                Binding="{Binding Name}"
                                                Width="260"/>
                                <DataGridTextColumn Header="Result"
                                                Binding="{Binding Result}"
                                                Width="90"/>
                                <DataGridTextColumn Header="Duration"
                                                Binding="{Binding Duration}"
                                                Width="120"/>
                                <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
