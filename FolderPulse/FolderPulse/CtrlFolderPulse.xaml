<UserControl x:Class="FolderPulse.CtrlFolderPulse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FolderPulse"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="Btn_Explorer" Content="폴더위치 열기" Margin="5" Command="{Binding Btn_ExplorerCMD}">

            </Button>
            <TextBlock FontSize="12" Text="{Binding Tb_SelectedFolderPath}" TextWrapping="Wrap" Margin="5" />
            <Button x:Name="Btn_Action" Content="폴더모니터링 활성화" Margin="5" Command="{Binding Btn_ActionCMD}">

            </Button>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="5" Background="LightGreen">
                    <Run Text="Activated Folder: "/><Run x:Name="tb_ActFolder" FontWeight="Bold" Text="{Binding Tb_ActivatedFolder}"/>
                </TextBlock>
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="5" Background="LightCyan">
                    <Run Text="Monitoring Interval: "/><Run x:Name="tb_MonitoringInterval" FontWeight="Bold" Text="{Binding Tb_MonitoringInterval}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="5" Background="LightSalmon">
                    <Run Text="Folder Size: "/><Run x:Name="tb_FolderSize" FontWeight="Bold" Text="{Binding Tb_FolderSize}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Left">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="5" Background="LightYellow">
                    <Run Text="Subfolder Count: "/><Run x:Name="tb_SubFolderCount" FontWeight="Bold" Text="{Binding Tb_SubFolderCount}"/>
                    </TextBlock>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="5" Background="LightBlue">
                    <Run Text="TotalFile Count: "/><Run x:Name="tb_FileCount" FontWeight="Bold" Text="{Binding Tb_FileCount}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
